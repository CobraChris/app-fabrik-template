<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <queries>
        <package android:name="de.blitzer.plus" />
        <package android:name="my.saphelink" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.spotify.music" />
        <!-- BRouter is installed and its offline data chosen by the user. -->
        <package android:name="btools.routingapp" />
        <!-- Required for Android 11+ visibility of system Text-to-Speech engines. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="${appDisplayName}"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fahrcockpit" android:host="transfer" />
            </intent-filter>
        </activity>
        <activity android:name=".EmbeddedMapActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity android:name=".SplitCockpitActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity android:name=".GoogleSetupActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity android:name=".IntegratedNavigationActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity android:name=".NavigationPreviewActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity android:name=".FuelActivity" android:exported="false" />
        <activity android:name=".UpdateActivity" android:exported="false" />

        <service
            android:name=".SpotifyNotificationListener"
            android:label="FahrCockpit Spotify-Medienzugriff"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".DockedCockpitService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_initiated_driving_controls_overlay" />
        </service>
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_initiated_driving_controls_overlay" />
        </service>
    </application>
</manifest>
